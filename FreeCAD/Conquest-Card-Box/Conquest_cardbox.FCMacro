# -*- coding: utf-8 -*-
# Conquest 2.0 — dokładne bryły BREP, bez siatki jako źródła CAD.
# Makro samodzielne: odtwarza bryły, weryfikuje i eksportuje STL oraz FCStd.
import FreeCAD as App
import FreeCADGui as Gui
import Part, MeshPart
import base64, zlib, tempfile, os, math
from PySide import QtGui
BASE_DATA = ''
LID_DATA = ''

def restore(data):
    fd, path = tempfile.mkstemp(suffix=".brep")
    try:
        with os.fdopen(fd,"wb") as f:
            f.write(zlib.decompress(base64.b64decode(data)))
        shape = Part.Shape()
        shape.read(path)
        if not shape.isValid() or len(shape.Solids) != 1:
            raise RuntimeError("Niepoprawna bryła CAD")
        return shape
    finally:
        os.remove(path)

doc = App.newDocument("Conquest_v2_0")
base = restore(BASE_DATA)
lid_closed = restore(LID_DATA)
if base.common(lid_closed).Volume > 0.00001:
    raise RuntimeError("Kolizja pokrywki z podstawą")
lid_print = lid_closed.copy()
lid_print.rotate(App.Vector(0,0,0),App.Vector(1,0,0),180)
lid_print.translate(App.Vector(0,69,46.85))
base_print = base.copy()
base_print.translate(App.Vector(2.5,2.5,0))
lid_print.translate(App.Vector(2,2,0))
a=doc.addObject("PartDesign::Feature","Base")
a.Label="Conquest 2.0 — podstawa, plaster miodu"
a.Shape=base_print
b=doc.addObject("PartDesign::Feature","Lid")
b.Label="Conquest 2.0 — pokrywka, logo +90°"
b.Shape=lid_print
b.Placement.Base=App.Vector(120,0,0)
for obj in (a,b):
    obj.addProperty("App::PropertyString","Specification","Projekt")
    obj.Specification="92 x 67 x 40; luz 1/stronę; bez magnesów; logo obrót +90°"
    obj.addProperty("App::PropertyString","Construction","Projekt")
    obj.Construction="216 przelotowych komórek; żebra ~2; pasy 3; naroża 4 mm"
    obj.ViewObject.ShapeColor=(0.85,0.81,0.65)
    obj.ViewObject.Deviation=0.05
    obj.ViewObject.AngularDeflection=5

doc.recompute()
Gui.activeDocument().activeView().viewAxonometric()
Gui.activeDocument().activeView().fitAll()
print("Wersja 2.0 gotowa: obie bryły poprawne, każda zawiera jeden solid.")
print("Podstawa i pokrywka ustawione do druku. Logo na spodzie pokrywki.")
folder=QtGui.QFileDialog.getExistingDirectory(None,"Wybierz folder zapisu STL i projektu FreeCAD")
if folder:
    for name, shape in [("Conquest_v2_podstawa",base_print),("Conquest_v2_pokrywka",lid_print)]:
        mesh=MeshPart.meshFromShape(Shape=shape,LinearDeflection=0.025,
             AngularDeflection=0.08,Relative=False)
        mesh.write(os.path.join(folder,name+".stl"))
    doc.recompute()
    doc.saveAs(os.path.join(folder,"Conquest_v2_0.FCStd"))
    print("Zapisano 2 STL oraz Conquest_v2_0.FCStd w:",folder)
